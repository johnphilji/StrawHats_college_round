# PATCHWORK frontend – local development defaults.
# Copy to .env to override. Never commit real secrets here.

# Express backend base URL (no trailing slash).
VITE_API_BASE_URL=http://localhost:4000

# Exact origin of the instrumented target website loaded in the preview
# iframe (no trailing slash). The target must allow this app origin via its
# own VITE_PATCHWORK_PARENT_ORIGIN setting.
# Default matches the target checkout's vite.config.js (port 5173), so run
# THIS app on a different port: `npm run dev -- --port 5174`.
VITE_PATCHWORK_TARGET_ORIGIN=http://localhost:5173
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_API_URL=http://localhost:4000/api
