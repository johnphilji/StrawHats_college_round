{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "isolatedModules": true
  },
  "include": ["src/**/*", "prisma.config.ts", "tests/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "generated"]
}
