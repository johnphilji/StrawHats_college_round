# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Database – PostgreSQL via Supabase (Prisma v7)
# DATABASE_URL is required for Prisma to connect; keep it server-side only.
# Example Supabase pooled URL: postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# If DATABASE_URL uses PgBouncer (port 6543), set DIRECT_URL to the direct connection for migrations (port 5432).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Supabase Auth – keep service/secret keys server-only
# SUPABASE_URL is your project URL (https://<project>.supabase.co)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy aliases – supported for compatibility (map to above):
# SUPABASE_ANON_KEY= (alias for SUPABASE_PUBLISHABLE_KEY)
# SUPABASE_SERVICE_ROLE_KEY= (alias for SUPABASE_SECRET_KEY)

# Target repository configuration (local Git checkout of demo repo)
# Example: TARGET_REPOSITORY_PATH=../frontend or /path/to/demo-repository
TARGET_REPOSITORY_PATH=

# No LLM generation provider or Vercel deployment provider is implemented.
# Keep future provider credentials server-side and add them only with an adapter.
# LLM_PROVIDER_API_KEY=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# GitHub App repository permissions are configured in GitHub, not via env vars.
# Writes require Contents: Read and write; pull request creation also requires
# Pull requests: Read and write. See API.md and accept the install permission update.
INTERNAL_WORKER_SECRET=
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
