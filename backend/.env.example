# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed to call the API. Include both the target
# site origin and the PATCHWORK frontend origin when they run on different
# ports (default local setup: target 5173, frontend 5174).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=info

# Database – PostgreSQL via Supabase (Prisma v7)
# DATABASE_URL is required for Prisma to connect; keep it server-side only.
# Example Supabase pooled URL: postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# If DATABASE_URL uses PgBouncer (port 6543), set DIRECT_URL to the direct connection for migrations (port 5432).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Supabase Auth – keep service/secret keys server-only
# SUPABASE_URL is your project URL (https://<project>.supabase.co)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy aliases – supported for compatibility (map to above):
# SUPABASE_ANON_KEY= (alias for SUPABASE_PUBLISHABLE_KEY)
# SUPABASE_SERVICE_ROLE_KEY= (alias for SUPABASE_SECRET_KEY)

# Target repository configuration (local checkout of the instrumented website)
# REQUIRED for component source resolution and the local edit pipeline.
# Set to the absolute path of your local target checkout, e.g.:
# TARGET_REPOSITORY_PATH=D:\CHRIS\javascript projects\Persia-Darbar-React-website
# (scheme + exact path depend on your machine; restart the server after changing it)
TARGET_REPOSITORY_PATH=

# Patch provider selection for the local edit pipeline.
# Today only the explicit mock is available: mock output is always labelled
# simulated:true and is never real LLM output. A future real-LLM adapter
# plugs into src/integrations/llm/provider.ts; wire its credentials then.
LLM_PROVIDER=mock

# GitHub App integration (repository listing + source retrieval).
# Without these three values every /api/github/* endpoint (except the
# unauthenticated callback) responds 503 "GitHub App integration is not
# configured." — that is the only missing piece; no code changes are needed.
#
# Setup:
#  1. Create a GitHub App at https://github.com/settings/apps/new
#     (or under your organization). No webhook is required.
#  2. Set the App's Setup URL to your backend callback:
#       http://localhost:4000/api/github/callback
#     (production: https://<your-api>/api/github/callback).
#  3. Permissions (minimum, read-only — do NOT grant write):
#       Contents: Read-only        (source file retrieval)
#       Metadata: Read-only        (mandatory for GitHub Apps; repository info)
#  4. Choose where the App can be installed (user and/or organization
#     accounts as needed). Installers may grant "all" or "selected"
#     repositories — both are supported.
#  5. Note the numeric App ID (App settings page) and the slug from the
#     App's public URL (https://github.com/apps/<slug>), then generate a
#     private key (App settings > Private keys) and paste it below.
#     Keep newlines: in .env files write literal newlines inside quotes or
#     \n escapes (the backend normalizes \\n to real newlines).
#  6. Never commit real values. Store production secrets in the hosting
#     platform's secret manager, never in frontend variables.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Future integrations – add when those modules are implemented (do not require for scaffold)
# LLM_PROVIDER_API_KEY=
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
